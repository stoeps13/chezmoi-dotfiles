[Unit]
Description=Weave web frontend for zk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ZK_NOTEBOOK_DIR=%h/zk
ExecStart=/bin/sh -c 'WEAVE_PASSWORD="$(/usr/bin/pass show weave/password)" exec %h/.local/bin/weave'
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
