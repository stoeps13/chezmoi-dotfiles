#!/usr/bin/env fish

set -e -u

{{- if eq .chezmoi.osRelease.id "cachyos" "arch" -}}
# Fisher is a fish function, not a binary — check via fish itself
if not fish -c "type fisher" >/dev/null 2>&1
    echo "Error: fisher is not available. Ensure 'fisher' is installed."
    exit 1
end

{{ range .packages.arch.fisher -}}
if not grep -qF {{ . | quote }} ~/.config/fish/fish_plugins 2>/dev/null
    echo "Installing fisher plugin: {{ . }}"
    fish -c "fisher install {{ . | quote }}"
end
{{ end -}}
{{ end -}}

{{- if eq .chezmoi.osRelease.id "cachyos" "arch" -}}
echo "Add local path to $PATH"
fish_add_path ~/go/bin; or true
fish_add_path ~/.cargo/bin; or true
fish_add_path ~/.local/bin; or true
{{ end -}}
